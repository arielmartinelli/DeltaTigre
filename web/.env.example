# --- Base de datos: Supabase (Transaction pooler, puerto 6543) ---
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres"

# --- Sesiones: cadena aleatoria larga ---
# generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambiar-por-una-cadena-aleatoria-larga"

# --- Contacto ---
NEXT_PUBLIC_WHATSAPP="5491100000000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Opcional: fotos subidas desde el panel a Supabase Storage ---
# Sin estas variables, las fotos se guardan en public/uploads (solo sirve en local).
# En Vercel son obligatorias porque el disco es de solo lectura.
SUPABASE_URL="https://XXXX.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="fotos"

# --- Google Search Console (opcional) ---
# Código del método "Etiqueta HTML", solo el valor del content=""
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
